NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" only once the device serves HTTPS (e.g. a self-signed
# cert on the Pi). Leave unset/false for plain-HTTP LAN deployment —
# browsers won't set a Secure cookie over HTTP, so flipping this on
# without TLS breaks login entirely. See lib/config.ts.
AUTH_COOKIE_SECURE=false
# Every node the dashboard shows, in the tab bar and on the "All nodes" page
# (server-side only). "Name=URL", comma separated, one line. Adding a node =
# appending ",Node X=http://<ip>:8000". A node that is down, or has no
# camera, still gets a card. Unset = the single node at NEXT_PUBLIC_API_BASE_URL.
ARGUS_NODES=Node A=http://10.0.0.140:8000,Node B=http://NODE_B_IP:8000,Node C=http://NODE_C_IP:8000
